{
  "name": "navrix-platform",
  "version": "1.0.0",
  "private": true,
  "description": "NAVRIX — Institutional Crypto Deposit, Immutable Ledger & Yield Investment Platform",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm --filter @navrix/web build",
    "dev": "pnpm --filter @navrix/backend dev",
    "start": "pnpm --filter @navrix/backend start",
    "dev:backend": "pnpm --filter @navrix/backend dev",
    "dev:web": "pnpm --filter @navrix/backend dev",
    "dev:admin": "pnpm --filter @navrix/backend dev",
    "dev:frontend": "pnpm --filter @navrix/backend dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "test:health": "node performance-testing/runner.js health-test.js",
    "test:smoke": "node performance-testing/runner.js smoke-test.js",
    "test:load": "node performance-testing/runner.js load-test.js",
    "test:stress": "node performance-testing/runner.js stress-test.js",
    "test:spike": "node performance-testing/runner.js spike-test.js",
    "test:api": "node performance-testing/runner.js api-test.js",
    "test:auth": "node performance-testing/runner.js auth-test.js",
    "test:product": "node performance-testing/runner.js product-test.js",
    "test:order": "node performance-testing/runner.js order-test.js",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "db:generate": "pnpm --filter @navrix/database db:generate",
    "db:migrate": "pnpm --filter @navrix/database db:migrate",
    "db:deploy": "pnpm --filter @navrix/database db:deploy",
    "db:push": "pnpm --filter @navrix/database db:push",
    "db:seed": "pnpm --filter @navrix/database db:seed",
    "db:setup": "pnpm --filter @navrix/database db:setup",
    "prepare": "husky || true",
    "share": "cloudflared tunnel --url http://localhost:3000",
    "share:cf": "cloudflared tunnel --url http://localhost:3000",
    "share:lt": "lt --port 3000",
    "share:ngrok": "ngrok http 3000"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md}": [
      "prettier --write"
    ]
  }
}
