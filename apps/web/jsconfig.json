{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@/pages/*": ["./src/pages-ui/*"],
      "@/pages-ui/*": ["./src/pages-ui/*"],
      "@/auth/*": ["./src/pages-ui/auth/*"]
    },
    "jsx": "preserve"
  },
  "include": ["src/**/*.js", "src/**/*.jsx"],
  "exclude": ["node_modules", ".next"]
}
